{
  "name": "react-speedrun-tools",
  "displayName": "React Speedrun Tools",
  "description": "Scaffold and style React apps with Vite, Next.js, fonts, and color variables.",
  "version": "0.1.0",
  "publisher": "AbhinavPrabhakar",
  "license": "MIT",
  "icon": "assets/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/Abhinav-Prabhakar/ReactSpeedrunTools.git"
  },
  "bugs": {
    "url": "https://github.com/Abhinav-Prabhakar/ReactSpeedrunTools/issues"
  },
  "homepage": "https://github.com/Abhinav-Prabhakar/ReactSpeedrunTools#readme",
  "keywords": [
    "react",
    "vite",
    "nextjs",
    "scaffold",
    "typescript",
    "sass",
    "css",
    "fonts"
  ],
  "engines": {
    "vscode": "^1.77.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "capabilities": {
    "virtualWorkspaces": {
      "supported": false,
      "description": "React Speedrun Tools inspects project files and runs your package manager, so it needs a local workspace."
    },
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "File generation works, but Sass is not installed automatically in untrusted workspaces."
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "react-speedrun-tools.scaffoldReactApp",
        "category": "React Speedrun Tools",
        "title": "Scaffold React App Files"
      },
      {
        "command": "react-speedrun-tools.removeBoilerplate",
        "category": "React Speedrun Tools",
        "title": "Clean Legacy CRA Boilerplate And Install Sass"
      },
      {
        "command": "react-speedrun-tools.createReactComponent",
        "category": "React Speedrun Tools",
        "title": "Create A New React Component"
      },
      {
        "command": "react-speedrun-tools.addFont",
        "category": "React Speedrun Tools",
        "title": "Add A Font"
      },
      {
        "command": "react-speedrun-tools.generateColorVariables",
        "category": "React Speedrun Tools",
        "title": "Generate Color Variables"
      }
    ],
    "configuration": {
      "title": "React Speedrun Tools",
      "properties": {
        "reactSpeedrunTools.language": {
          "type": "string",
          "enum": ["auto", "javascript", "typescript"],
          "enumDescriptions": [
            "Detect the language from the project",
            "Generate .jsx and .js files",
            "Generate .tsx and .ts files"
          ],
          "default": "auto",
          "description": "Language used when generating React files."
        },
        "reactSpeedrunTools.styling": {
          "type": "string",
          "enum": ["auto", "css", "scss", "sass", "tailwind"],
          "enumDescriptions": [
            "Detect the styling approach from the project",
            "Plain CSS",
            "SCSS",
            "Indented Sass",
            "Tailwind CSS"
          ],
          "default": "auto",
          "description": "Styling approach used when scaffolding and generating styles."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run check-types && npm run lint && npm run bundle",
    "compile": "tsc -p ./",
    "check-types": "tsc --noEmit -p ./",
    "watch": "tsc -watch -p ./",
    "bundle": "node esbuild.js",
    "bundle:watch": "node esbuild.js --watch",
    "pretest": "npm run compile && npm run bundle && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.77.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.1.0",
    "esbuild": "^0.28.0",
    "eslint": "^9.0.0",
    "typescript": "^5.0.0"
  }
}
